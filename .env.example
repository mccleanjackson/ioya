# Copy this file to .env and fill in your project's values. .env is git-ignored.
# Find both in Supabase: Project Settings → API (or the Connect button).
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
PORT=3001
# Set the deployed HTTPS origin to enable links and QR codes for payment requests.
# IOYA_PUBLIC_ORIGIN=https://your-ioya-host.example.com
# Automatic texts (deployed server only). Provision an SMS-capable sender in this Twilio Messaging Service.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_API_KEY_SID=SK...
# TWILIO_API_KEY_SECRET=
# TWILIO_MESSAGING_SERVICE_SID=MG...
# IOYA_SMS_ALLOWED_USERS=comma-separated-Supabase-Auth-user-UUIDs
